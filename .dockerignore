# Docker build context settings.
#
# NOTE: DO NOT list `frontend/` here — the Emergent Deploy platform's multi-stage
# builder needs both `frontend/` and `backend/` folders in the build context to
# assemble the full-stack image. The custom /app/Dockerfile (used only with
# direct `fly deploy` CLI) already scopes to `backend/` via its own COPY step,
# so no ignore is needed for that path either.
node_modules/

# Local envs & secrets — Fly reads secrets via `fly secrets set`.
**/.env
**/.env.*
!**/.env.example

# Python cruft
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Tests & reports — not needed at runtime
test_reports/
tests/
backend/tests/

# Dev/editor
.git/
.gitignore
.emergent/
.vscode/
.idea/
.DS_Store

# Docs & memory (not used at runtime)
memory/
*.md
!README.md

# Tooling
tmp/
